# Copie ce fichier en .env pour le développement local.
# Sur alwaysdata, définis ces variables dans la configuration du site Node.js.

NODE_ENV=development
PORT=3000

# Base MySQL (alwaysdata : Bases de données > MySQL)
DB_HOST=mysql-childapp.alwaysdata.net
DB_PORT=3306
DB_USER=childapp_xxx        # l'utilisateur MySQL que tu as créé
DB_PASSWORD=change_me
DB_NAME=childapp_xxx        # le nom de la base, préfixé par ton compte

# Secret de signature des jetons de connexion (32 caractères minimum, aléatoire).
# Génère-en un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Connexion Spotify du parent (developer.spotify.com/dashboard). Contrairement
# au client_id, le client_secret ne doit JAMAIS être mis dans le client React :
# c'est justement pour ça que l'échange de jetons se fait ici, côté serveur.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Doit être déclarée telle quelle dans le Spotify Dashboard (Redirect URIs).
SPOTIFY_REDIRECT_URI=https://childapp.alwaysdata.net/api/spotify/callback
